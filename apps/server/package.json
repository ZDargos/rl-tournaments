{
  "name": "@rl/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "node --env-file-if-exists=../../.env dist/cli.js migrate",
    "backup": "node --env-file-if-exists=../../.env dist/cli.js backup",
    "register-commands": "node --env-file-if-exists=../../.env dist/cli.js register-commands"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "10.3.0",
    "@rl/core": "1.0.0",
    "better-sqlite3": "12.11.1",
    "discord.js": "14.27.0",
    "fastify": "5.12.7",
    "pino": "9.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "0.25.12",
    "tsx": "4.23.15"
  }
}
