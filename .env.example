# Copy to .env (never commit .env; it is in .gitignore) and fill in on the machine that runs the server.
# Nothing in this file is ever sent to the website. The website only knows VITE_API_URL (set in GitHub, see docs/DEPLOYMENT.md).

NODE_ENV=production
# Address the API listens on. Keep 127.0.0.1 when Tailscale Funnel / a reverse proxy sits in front.
HOST=127.0.0.1
PORT=8787

# Public HTTPS URL of this API (what browsers and Discord OAuth reach), no trailing slash.
# Example with Tailscale Funnel: https://my-machine.tail1234.ts.net
PUBLIC_API_URL=https://my-machine.tail1234.ts.net
# Public URL of the website (GitHub Pages), no trailing slash. Used for CORS and login redirects.
WEB_URL=https://your-github-username.github.io/rl-tournaments

DATABASE_PATH=./data/rl-tournaments.db
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# From https://discord.com/developers/applications -> your app.
DISCORD_CLIENT_ID=
# OAuth2 -> Client Secret. SECRET: server only.
DISCORD_CLIENT_SECRET=
# Bot -> Token. SECRET: server only. Reset it in the portal immediately if it ever leaks.
DISCORD_BOT_TOKEN=
# Optional: register slash commands to one server instantly while testing (otherwise global).
DISCORD_DEV_GUILD_ID=

# Set to true to run the website/API without connecting to Discord.
DISCORD_DISABLED=false
# Development only: password-less test login. The server refuses to start with this in production.
DEV_LOGIN=false

SESSION_TTL_DAYS=30
JOB_INTERVAL_SECONDS=15
LOG_LEVEL=info
# true only when a reverse proxy on the same machine sets X-Forwarded-For (Tailscale Funnel does).
TRUST_PROXY=true
